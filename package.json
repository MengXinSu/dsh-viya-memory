{
  "name": "viya-memory",
  "version": "0.1.0",
  "description": "本地长期记忆 for DeepSeek Harness：卡片以 Markdown 存在你自己的 Obsidian vault 里，提供 save/search/read/update/link/forget/stats 七个工具 · Local long-term memory as plain Markdown cards in your own Obsidian vault.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible"
      },
      "node": ">=20.18",
      "profiles": [
        "desktop"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "obsidian",
    "markdown",
    "ai-memory"
  ],
  "license": "MIT",
  "author": "MengXinSu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MengXinSu/dsh-viya-memory.git"
  },
  "bugs": {
    "url": "https://github.com/MengXinSu/dsh-viya-memory/issues"
  },
  "homepage": "https://github.com/MengXinSu/dsh-viya-memory#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "test": "node --test tests/selftest.mjs"
  }
}
